# LeLab settings. Copy this file to `.env` and edit, then restart LeLab.
#
# Where `.env` is read from:
#   - leLab-main/.env (next to pyproject.toml): read by `lelab-gamepad` and by
#     Vite (`npm run dev`, `npm run build`, `npm run preview`).
#   - .env in the directory you run `lelab-gamepad` from: for an installed copy
#     with no source checkout. It wins over leLab-main/.env.
# Variables already set in your shell win over both.

# FastAPI backend; in normal mode it also serves the web app (http://localhost:8000).
# The built app calls the backend on its own origin, so changing this needs no
# rebuild. The Vite dev server and `npm run build` use it to find the backend.
LELAB_BACKEND_PORT=8000

# Vite dev server for `lelab-gamepad --dev` / `npm run dev`.
LELAB_FRONTEND_DEV_PORT=8081

# `npm run preview`. The Hugging Face Space Docker image sets 7860.
LELAB_PREVIEW_PORT=4173

# Where files are kept. Read by `lelab-gamepad` only. Leave these commented out
# to use ~/.cache/huggingface/lerobot. Changing one doesn't move files already
# saved: copy them to the new place yourself. On Windows, write paths with
# forward slashes (D:/lerobot), since a backslash can be read as an escape.
#
# Everything Hugging Face keeps, including your login token and downloaded
# models; LeLab and lerobot files go in its lerobot/ subfolder.
# HF_HOME=~/huggingface
#
# Only LeLab and lerobot files: calibration, datasets, robots, ports.
# HF_LEROBOT_HOME=~/lerobot
#
# Only calibration files.
# HF_LEROBOT_CALIBRATION=~/lerobot/calibration
